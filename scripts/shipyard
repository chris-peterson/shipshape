#!/usr/bin/env bash
# Fetch-and-run shipyard — the shared plugin build tooling
# (github.com/chris-peterson/shipyard). Keeps a cached checkout at `v1` — a
# branch or a tag, whichever it currently is — updates it, and runs the
# requested command against this repo. No package install; shipyard's one dependency (pyyaml) must be
# importable (`pip install pyyaml` once, or the system package).
#
# Env overrides: SHIPYARD_REF (branch/tag, default v1), SHIPYARD_HOME
# (cache location).
set -euo pipefail

ref="${SHIPYARD_REF:-v1}"
cache="${SHIPYARD_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/shipyard}"
repo="https://github.com/chris-peterson/shipyard.git"

if [ -d "$cache/.git" ]; then
  # Reset to what the fetch just downloaded, not to `origin/$ref`: that
  # remote-tracking ref only exists while $ref is a branch, and it keeps
  # answering with its last branch value after $ref becomes a tag — pinning the
  # build to a stale generator while CI, which resolves the tag, moves on.
  git -C "$cache" fetch --quiet origin "$ref"
  git -C "$cache" reset --hard --quiet FETCH_HEAD
else
  git clone --quiet --branch "$ref" "$repo" "$cache"
fi

# shipyard resolves --root to the current directory, so run it from the repo root.
PYTHONPATH="$cache/src" exec python3 -m shipyard "$@"
